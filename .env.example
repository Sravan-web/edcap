# ==============================================================================
# EdCap — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ==============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=EdCap
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_python_secrets_token_hex_32
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite — no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./edcap.db
# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://edcap:password@localhost:5432/edcap

# ── Auth / JWT ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_IDLE_TIMEOUT_MIN=30
SESSION_ABS_TIMEOUT_H=8

# ── Login Protection ─────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
CAPTCHA_PROVIDER=stub
# CAPTCHA_SECRET_KEY=your_turnstile_secret
# CAPTCHA_SITE_KEY=your_turnstile_site_key

# ── MFA ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MFA_SECRET_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64_ENCODED

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@edcap.demo
# For production SMTP:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_TLS=true

# ── Upload Limits ─────────────────────────────────────────────────────────────
UPLOAD_MAX_CSV_MB=5
UPLOAD_MAX_MODULE_MB=20
UPLOAD_STORAGE_PATH=uploads

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=offline
# For production with OpenAI:
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ── Rule Engine ──────────────────────────────────────────────────────────────
RULE_BELOW_AVG_PCT=15.0
RULE_BELOW_AVG_WINDOW=5
RULE_BELOW_AVG_MIN_FIRES=3
RULE_TREND_SLOPE=-2.0
RULE_TREND_MIN_ASSESSMENTS=4
RULE_TOPIC_ACCURACY_PCT=50.0
RULE_TOPIC_MIN_ATTEMPTS=5

# ── Quiz ─────────────────────────────────────────────────────────────────────
QUIZ_QUESTIONS_PER_DAY=20
QUIZ_MIX_CORE=12
QUIZ_MIX_APPLICATION=5
QUIZ_MIX_PREREQ=3
LLM_MAX_RETRIES=2

# ── Spaced Repetition ────────────────────────────────────────────────────────
SR_INTERVALS_DAYS=1,3,7,14

# ── Telemetry ────────────────────────────────────────────────────────────────
TELEMETRY_FLUSH_INTERVAL_S=5
TELEMETRY_RATE_LIMIT_PER_MINUTE=300

# ── Data Retention ───────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=365
